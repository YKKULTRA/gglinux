# Maintainer: YKKULTRA
pkgname=gglinux-git
pkgver=r0.0000000
pkgrel=1
pkgdesc="Open-source SteelSeries GG for Linux: lighting, headset, Sonar-style audio, GameSense, clips"
arch=('x86_64')
url="https://github.com/YKKULTRA/gglinux"
license=('GPL-3.0-or-later')
# Linked: glibc and libgcc (all binaries), systemd-libs (libudev, for the daemon), fontconfig (the
# app's fonts). Loaded by the app at run time, not linked: wayland and libxkbcommon (or libx11 on
# X11), libglvnd (EGL/OpenGL for drawing). Run, not linked: pipewire and wireplumber (the pw-*
# tools and wpctl), xdg-utils (xdg-open). The tray and the one-copy guard talk to the session bus
# themselves.
depends=('glibc' 'libgcc' 'systemd-libs' 'fontconfig'
         'wayland' 'libxkbcommon' 'libglvnd' 'hicolor-icon-theme'
         'pipewire' 'wireplumber' 'xdg-utils')
makedepends=('git' 'cargo')
optdepends=('noise-suppression-for-voice: noise suppression for the Sonar microphone'
            'swh-plugins: compressor for the Sonar microphone and Smart Volume'
            'gpu-screen-recorder: instant-replay clips'
            'xdg-desktop-portal: the clip hotkey, screen capture and file dialogs, with a backend like xdg-desktop-portal-kde'
            'libx11: the app on an X11 session'
            'libxcursor: cursors on an X11 session')
provides=('gglinux')
conflicts=('gglinux')
# makepkg's LTO flags make hidapi's bundled C code GCC LTO bitcode, which the Rust linker
# cannot read: the daemon then fails to link with undefined hid_read/hid_write symbols.
options=('!lto')
install=gglinux.install
source=("gglinux::git+https://github.com/YKKULTRA/gglinux.git")
sha256sums=('SKIP')

pkgver() {
  cd gglinux
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd gglinux
  # Everything that needs the network happens here, so build() and check() can run offline.
  export RUSTUP_TOOLCHAIN=stable
  local host
  host="$(rustc -vV | sed -n 's/^host: //p')"
  cargo fetch --locked --target "$host"
}

build() {
  cd gglinux
  export RUSTUP_TOOLCHAIN=stable
  # The daemon, ggctl and the app, into the checkout's target/, where package() looks, even if
  # CARGO_TARGET_DIR or a cargo config names another target dir.
  CARGO_TARGET_DIR="$PWD/target" cargo build --release --frozen -p gglinuxd -p gglinux --bins
}

check() {
  cd gglinux
  export RUSTUP_TOOLCHAIN=stable
  CARGO_TARGET_DIR="$PWD/target" cargo test --release --frozen --workspace
}

package() {
  cd gglinux
  install -Dm755 target/release/gglinuxd "$pkgdir/usr/bin/gglinuxd"
  install -Dm755 target/release/ggctl "$pkgdir/usr/bin/ggctl"
  install -Dm755 target/release/gglinux "$pkgdir/usr/bin/gglinux"
  # The unit in the repo runs ~/.local/bin/gglinuxd, where install-local.sh puts it.
  sed 's|^ExecStart=.*|ExecStart=/usr/bin/gglinuxd|' data/systemd/gglinuxd.service \
    | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/gglinuxd.service"
  install -Dm644 data/udev/60-gglinux.rules "$pkgdir/usr/lib/udev/rules.d/60-gglinux.rules"
  # Shipped but not active: reactive lighting is an opt-in, as gglinux.install explains.
  install -Dm644 data/udev/61-gglinux-reactive.rules "$pkgdir/usr/share/gglinux/61-gglinux-reactive.rules"
  # Named after the app id: the desktop portal finds gglinux by it (the clip hotkey).
  sed 's|^Exec=.*|Exec=/usr/bin/gglinux|' data/io.github.ykk.gglinux.desktop \
    | install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/io.github.ykk.gglinux.desktop"
  install -Dm644 data/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/gglinux.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
