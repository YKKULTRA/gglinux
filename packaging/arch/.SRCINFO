pkgbase = gglinux-git
	pkgdesc = Open-source SteelSeries GG for Linux: lighting, headset, Sonar-style audio, GameSense, clips
	pkgver = r0.0000000
	pkgrel = 1
	url = https://github.com/YKKULTRA/gglinux
	install = gglinux.install
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = git
	makedepends = cargo
	depends = glibc
	depends = libgcc
	depends = systemd-libs
	depends = fontconfig
	depends = wayland
	depends = libxkbcommon
	depends = libglvnd
	depends = hicolor-icon-theme
	depends = pipewire
	depends = wireplumber
	depends = xdg-utils
	optdepends = noise-suppression-for-voice: noise suppression for the Sonar microphone
	optdepends = swh-plugins: compressor for the Sonar microphone and Smart Volume
	optdepends = gpu-screen-recorder: instant-replay clips
	optdepends = xdg-desktop-portal: the clip hotkey, screen capture and file dialogs, with a backend like xdg-desktop-portal-kde
	optdepends = libx11: the app on an X11 session
	optdepends = libxcursor: cursors on an X11 session
	provides = gglinux
	conflicts = gglinux
	options = !lto
	source = gglinux::git+https://github.com/YKKULTRA/gglinux.git
	sha256sums = SKIP

pkgname = gglinux-git
