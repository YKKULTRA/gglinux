post_install() {
  cat <<'EOF'
==> gglinux: if you installed it with scripts/install-local.sh before, remove that copy, or
    its daemon, app-menu entry and ggctl in your home run instead of this package's.
    Quit gglinux from its tray, then:
      systemctl --user disable --now gglinuxd
      rm -f ~/.local/bin/{gglinuxd,gglinux,ggctl} ~/.config/systemd/user/gglinuxd.service
      rm -f ~/.local/share/applications/{gglinux,io.github.ykk.gglinux}.desktop ~/.config/autostart/gglinux.desktop
      systemctl --user daemon-reload
==> gglinux: start the daemon for your user with
      systemctl --user enable --now gglinuxd
    then open gglinux from the app menu (Settings -> Start at login keeps both running).
==> Reactive keyboard lighting needs read access to the Apex's typing interfaces,
    which lets any program you run read what you type on it. Opt in only if you want it:
      sudo install -m644 /usr/share/gglinux/61-gglinux-reactive.rules /etc/udev/rules.d/
      sudo udevadm control --reload   # then replug the keyboard
==> On KDE Plasma, profile rules that act on the focused window need gglinux's KWin script.
    Turn on "gglinux focus" in System Settings -> Window Management -> KWin Scripts, or:
      kwriteconfig6 --file kwinrc --group Plugins --key gglinux-focusEnabled true
      qdbus6 org.kde.KWin /KWin reconfigure
EOF
}

post_upgrade() {
  post_install
}
