// The look the web UI had: dark, one orange accent.

export global Theme {
    out property <color> bg: #0c0e11;
    out property <color> surface: #14171c;
    out property <color> surface-2: #1c2027;
    out property <color> line: #262b33;
    out property <color> text: #e6e9ee;
    out property <color> text-dim: #8b939f;
    out property <color> accent: #ff7a29;
    out property <color> accent-2: #ff4d6d;
    out property <color> ok: #3ddc84;
    out property <color> danger: #ff5f56;
    out property <length> font: 13.5px;
    out property <length> small: 12px;
    out property <length> tiny: 11px;
    out property <string> mono: "monospace";
}
