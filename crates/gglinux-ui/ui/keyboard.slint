// SPDX-License-Identifier: GPL-3.0-or-later
// The Apex Pro TKL Gen 3: lighting, switches and the screen, in one card.

import { ComboBox, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Card, Hint, ErrorLine, Toggle, Button, Segmented, AccentSlider, PanelHead, Row, Unit, Head, Divider, Shown, ColorPick, Board, Key } from "widgets.slint";

export global KeyboardUi {
    in property <bool> known;
    in property <bool> connected;
    in property <float> cols: 17.5;
    in property <float> rows: 6.5;
    /// Lighting: gglinux draws it, or the keyboard's own profile does.
    in property <bool> enabled;
    /// 0 static, 1 breathing, 2 wave, 3 spectrum, 4 audio.
    in property <int> effect;
    in property <color> breathing-color;
    in property <bool> has-period;
    in property <float> period: 4;
    in property <float> sensitivity: 1;
    in property <int> brightness: 100;
    in property <bool> reactive;
    in property <int> reactive-mode;
    in property <color> reactive-color;
    in property <float> duration: 0.6;
    in property <string> reactive-status;
    in property <bool> no-access;
    in property <bool> mute;
    in property <[string]> key-names;
    /// Two-way with the list: a pick lands here, and the daemon's key comes back.
    in-out property <int> mute-key;
    in property <color> mute-color;
    in property <[Key]> keys;
    in property <int> selected;
    in property <bool> dirty;
    in-out property <color> brush: #00c8ff;
    /// Bumped to open the brush's picker (the shot example's step).
    in property <int> open-brush;
    in property <bool> busy;
    in property <string> error;
    callback set-enabled(bool);
    callback set-effect(int);
    callback set-breathing-color(color);
    callback set-period(float);
    callback set-sensitivity(float);
    callback set-brightness(int);
    callback set-reactive(bool);
    callback set-reactive-mode(int);
    callback set-reactive-color(color);
    callback set-duration(float);
    callback set-mute(bool);
    callback set-mute-key(int);
    callback set-mute-color(color);
    callback key-clicked(int);
    callback paint-selected();
    callback paint-all();
    callback clear-selection();
    callback apply-static();
}

export struct TapRow {
    a: int,
    b: int,
    mode: int,
    both: bool,
}

export global SwitchesUi {
    in property <bool> enabled;
    in property <int> actuation: 20;
    in property <[Key]> keys;
    in property <int> selected;
    in-out property <int> own-level: 15;
    in property <bool> rapid;
    in property <int> rapid-distance: 2;
    in property <string> rapid-keys;
    in property <bool> rapid-some;
    in property <bool> tap;
    in property <[string]> key-names;
    in property <[TapRow]> pairs;
    in property <string> refused;
    in property <bool> busy;
    in property <string> error;
    out property <[string]> tap-modes: ["Last pressed wins", "Neither counts", "First key wins", "Second key wins"];
    callback set-enabled(bool);
    callback set-actuation(int);
    callback key-clicked(int);
    callback set-own(bool);
    callback clear-selection();
    callback set-rapid(bool);
    callback set-rapid-distance(int);
    callback rapid-only-selected();
    callback rapid-every-key();
    callback set-tap(bool);
    callback set-pair(int, int, int, int, bool);
    callback add-pair();
    callback remove-pair(int);
}

export global ScreenUi {
    /// 0 the keyboard's own, 1 text, 2 clock, 3 picture: the tab shown.
    in property <int> kind;
    in-out property <string> text;
    in property <bool> too-long;
    /// Nothing but spaces: nothing to show.
    in property <bool> blank: true;
    in property <bool> h24: true;
    in property <bool> seconds;
    in property <bool> date: true;
    in property <string> file-name;
    in property <bool> has-source;
    in property <bool> has-preview;
    in property <image> preview;
    in property <int> threshold: 128;
    in property <bool> dither: true;
    in property <bool> invert;
    in property <bool> care;
    in property <bool> shift;
    in property <bool> away;
    in property <bool> own-too;
    in property <bool> resting;
    in property <string> refused;
    in property <bool> busy;
    in property <string> error;
    callback pick(int);
    callback text-edited(string);
    callback show-text();
    callback set-clock(bool, bool, bool);
    callback choose-picture();
    callback set-threshold(int);
    callback set-dither(bool);
    callback set-invert(bool);
    callback show-picture();
    callback set-care(bool, bool, bool);
}

/// Its content with `gap` above, or nothing at all, gap included, while not
/// `shown`. A layout's spacing also goes around children that take no room, so
/// the sections here use none and each piece brings its own gap.
component Opt {
    in property <bool> shown: true;
    in property <length> gap: 10px;
    visible: root.shown;
    height: root.shown ? inner.preferred-height : 0px;
    inner := VerticalLayout {
        padding-top: root.gap;
        @children
    }
}

/// A heading inside a section ("Rapid Trigger"), lighter than the section's own.
component SubTitle inherits Text {
    color: Theme.text;
    font-size: Theme.small;
    font-weight: 600;
}

/// A command to copy: like `Code`, but the text can be selected.
component CopyCode inherits Rectangle {
    in property <string> text;
    background: Theme.bg;
    border-color: Theme.line;
    border-width: 1px;
    border-radius: 8px;
    HorizontalLayout {
        padding: 10px;
        TextInput {
            text: root.text;
            read-only: true;
            single-line: false;
            wrap: word-wrap;
            font-family: Theme.mono;
            font-size: Theme.small;
            color: Theme.accent;
            selection-background-color: Theme.accent.with-alpha(0.3);
        }
    }
}

component Lighting {
    VerticalLayout {
        Toggle {
            text: "gglinux controls the lighting (off: the keyboard's own profile)";
            checked: KeyboardUi.enabled;
            enabled: !KeyboardUi.busy;
            toggled(v) => { KeyboardUi.set-enabled(v); }
        }
        Opt { shown: KeyboardUi.enabled; gap: 14px; VerticalLayout {
            Divider { }
            Opt { gap: 14px; Head { text: "EFFECT"; } }
            Opt { HorizontalLayout {
                alignment: start;
                Segmented {
                    options: ["Static", "Breathing", "Wave", "Spectrum", "Audio"];
                    current: KeyboardUi.effect;
                    enabled: !KeyboardUi.busy;
                    picked(i) => { KeyboardUi.set-effect(i); }
                }
            } }
            Opt { shown: KeyboardUi.effect == 1; Row {
                label: "Colour";
                ColorPick { value: KeyboardUi.breathing-color; enabled: !KeyboardUi.busy; picked(c) => { KeyboardUi.set-breathing-color(c); } }
                Rectangle { horizontal-stretch: 1; }
            } }
            Opt { shown: KeyboardUi.has-period; Row {
                label: "Speed";
                speed := AccentSlider { minimum: 0.5; maximum: max(20, KeyboardUi.period); step: 0.5; value: KeyboardUi.period; enabled: !KeyboardUi.busy; released(v) => { KeyboardUi.set-period(v); } }
                Unit { text: speed.shown + " s"; }
            } }
            Opt { shown: KeyboardUi.effect == 4; VerticalLayout {
                spacing: 10px;
                Row {
                    label: "Sensitivity";
                    sens := AccentSlider { minimum: 0.25; maximum: 4; step: 0.25; value: KeyboardUi.sensitivity; enabled: !KeyboardUi.busy; released(v) => { KeyboardUi.set-sensitivity(v); } }
                    Unit { text: sens.shown.to-fixed(2) + "×"; }
                }
                Hint { text: "What's playing is analysed live and never recorded; your desktop may show that audio is being captured."; }
            } }
            Opt { Row {
                label: "Brightness";
                bright := AccentSlider { minimum: 0; maximum: 100; step: 5; value: KeyboardUi.brightness; enabled: !KeyboardUi.busy; released(v) => { KeyboardUi.set-brightness(v); } }
                Unit { text: bright.shown + "%"; }
            } }
            Opt { gap: 14px; Divider { } }
            Opt { gap: 14px; Head { text: "REACTIVE"; state: KeyboardUi.reactive ? KeyboardUi.reactive-status : ""; } }
            Opt { Toggle { text: "Light keys as you press them"; checked: KeyboardUi.reactive; enabled: !KeyboardUi.busy; toggled(v) => { KeyboardUi.set-reactive(v); } } }
            Opt { shown: KeyboardUi.reactive; VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    alignment: start;
                    Segmented { options: ["Fade", "Ripple"]; current: KeyboardUi.reactive-mode; enabled: !KeyboardUi.busy; picked(i) => { KeyboardUi.set-reactive-mode(i); } }
                }
                Row {
                    label: "Colour";
                    ColorPick { value: KeyboardUi.reactive-color; enabled: !KeyboardUi.busy; picked(c) => { KeyboardUi.set-reactive-color(c); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                Row {
                    label: "Duration";
                    dur := AccentSlider { minimum: 0.1; maximum: 3; step: 0.1; value: KeyboardUi.duration; enabled: !KeyboardUi.busy; released(v) => { KeyboardUi.set-duration(v); } }
                    Unit { text: dur.shown.to-fixed(1) + " s"; }
                }
            } }
            Opt { shown: KeyboardUi.reactive && KeyboardUi.no-access; Rectangle {
                background: Theme.surface-2;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.line;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Hint { text: "Reactive lighting needs to see which keys you press. The optional udev rule lets any program you run read what you type on the Apex while you're logged in. gglinux reads only while reactive lighting is on, and keeps presses in memory only until their light fades."; }
                    Hint { text: "To allow it, add the optional rule, then replug the keyboard:"; }
                    CopyCode { text: "sudo install -m644 /usr/share/gglinux/61-gglinux-reactive.rules /etc/udev/rules.d/\nsudo udevadm control --reload"; }
                    Hint { text: "Built from source? Copy data/udev/61-gglinux-reactive.rules from the checkout instead."; }
                }
            } }
            Opt { gap: 14px; Divider { } }
            Opt { gap: 14px; Head { text: "MIC MUTE LIGHT"; } }
            Opt { Toggle { text: "Light a key while the microphone is muted"; checked: KeyboardUi.mute; enabled: !KeyboardUi.busy; toggled(v) => { KeyboardUi.set-mute(v); } } }
            Opt { shown: KeyboardUi.mute; Row {
                label: "Key";
                ComboBox { width: 140px; model: KeyboardUi.key-names; current-index <=> KeyboardUi.mute-key; enabled: !KeyboardUi.busy; selected => { KeyboardUi.set-mute-key(self.current-index); } }
                ColorPick { value: KeyboardUi.mute-color; enabled: !KeyboardUi.busy; picked(c) => { KeyboardUi.set-mute-color(c); } }
                Rectangle { horizontal-stretch: 1; }
            } }
            Opt { shown: KeyboardUi.effect == 0; gap: 14px; VerticalLayout {
                spacing: 10px;
                Divider { }
                VerticalLayout {
                    padding-top: 4px;
                    Head { text: "KEYS"; state: KeyboardUi.dirty ? "not applied yet" : ""; }
                }
                Board { keys: KeyboardUi.keys; cols: KeyboardUi.cols; rows: KeyboardUi.rows; clicked(i) => { KeyboardUi.key-clicked(i); } }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    brush := ColorPick {
                        property <int> asked: KeyboardUi.open-brush;
                        value: KeyboardUi.brush;
                        picked(c) => { KeyboardUi.brush = c; }
                        changed asked => { self.open(); }
                    }
                    Button { text: "Paint selected (\{KeyboardUi.selected})"; enabled: KeyboardUi.selected > 0; clicked => { KeyboardUi.paint-selected(); } }
                    Button { text: "Paint all"; clicked => { KeyboardUi.paint-all(); } }
                    Button { text: "Clear selection"; enabled: KeyboardUi.selected > 0; clicked => { KeyboardUi.clear-selection(); } }
                }
                HorizontalLayout {
                    alignment: start;
                    Button { text: "Apply to keyboard"; primary: KeyboardUi.dirty; enabled: !KeyboardUi.busy; clicked => { KeyboardUi.apply-static(); } }
                }
            } }
        } }
        Opt { shown: KeyboardUi.error != ""; ErrorLine { text: KeyboardUi.error; } }
    }
}

component Switches {
    VerticalLayout {
        Head { text: "SWITCHES"; }
        Opt { Toggle { text: "gglinux sets the switches (off: the keyboard keeps its own)"; checked: SwitchesUi.enabled; enabled: !SwitchesUi.busy; toggled(v) => { SwitchesUi.set-enabled(v); } } }
        Opt { Hint { text: "The keyboard keeps these in memory, not in its flash, so gglinux sends them again each time it connects. Turned off, the keyboard keeps the last ones until it's unplugged."; } }
        Opt { shown: SwitchesUi.enabled; gap: 14px; VerticalLayout {
            Row {
                label: "Actuation";
                act := AccentSlider { minimum: 1; maximum: 40; value: SwitchesUi.actuation; enabled: !SwitchesUi.busy; released(v) => { SwitchesUi.set-actuation(v); } }
                Unit { text: (act.shown / 10).to-fixed(1) + " mm for every key without its own"; }
            }
            Opt { gap: 12px; Board { keys: SwitchesUi.keys; cols: KeyboardUi.cols; rows: KeyboardUi.rows; clicked(i) => { SwitchesUi.key-clicked(i); } } }
            Opt { Hint { text: "Click keys to select them. Grey keys have fixed switches; keys with their own point are outlined, and Rapid Trigger keys are tinted."; } }
            Opt { Row {
                label: "Selected (\{SwitchesUi.selected})";
                own := AccentSlider { minimum: 1; maximum: 40; value: SwitchesUi.own-level; released(v) => { SwitchesUi.own-level = v; } }
                Unit { text: (own.shown / 10).to-fixed(1) + " mm"; }
            } }
            Opt { HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Button { text: "Set for selected"; enabled: !SwitchesUi.busy && SwitchesUi.selected > 0; clicked => { SwitchesUi.set-own(true); } }
                Button { text: "Back to the default"; enabled: !SwitchesUi.busy && SwitchesUi.selected > 0; clicked => { SwitchesUi.set-own(false); } }
                Button { text: "Clear selection"; enabled: SwitchesUi.selected > 0; clicked => { SwitchesUi.clear-selection(); } }
            } }
            Opt { gap: 20px; SubTitle { text: "Rapid Trigger"; } }
            Opt { Toggle { text: "A key resets as soon as it starts to rise, and fires again as soon as it goes back down"; checked: SwitchesUi.rapid; enabled: !SwitchesUi.busy; toggled(v) => { SwitchesUi.set-rapid(v); } } }
            Opt { shown: SwitchesUi.rapid; VerticalLayout {
                spacing: 10px;
                Row {
                    label: "Distance";
                    dist := AccentSlider { minimum: 1; maximum: 20; value: SwitchesUi.rapid-distance; enabled: !SwitchesUi.busy; released(v) => { SwitchesUi.set-rapid-distance(v); } }
                    Unit { text: (dist.shown / 10).to-fixed(1) + " mm"; }
                }
                Row {
                    label: "Keys";
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Unit { text: SwitchesUi.rapid-keys; min-width: 0; }
                        Button { text: "Only the selected"; small: true; enabled: !SwitchesUi.busy && SwitchesUi.selected > 0; clicked => { SwitchesUi.rapid-only-selected(); } }
                        Button { text: "Every key"; small: true; enabled: !SwitchesUi.busy && SwitchesUi.rapid-some; clicked => { SwitchesUi.rapid-every-key(); } }
                    }
                }
            } }
            Opt { gap: 20px; SubTitle { text: "Rapid Tap"; } }
            Opt { Toggle { text: "With both keys of a pair held, the keyboard decides which one counts (SOCD)"; checked: SwitchesUi.tap; enabled: !SwitchesUi.busy; toggled(v) => { SwitchesUi.set-tap(v); } } }
            Opt { shown: SwitchesUi.tap; VerticalLayout {
                spacing: 10px;
                // The lists give way to the rest in a narrow window.
                for p[i] in SwitchesUi.pairs : HorizontalLayout {
                    spacing: 8px;
                    ComboBox { min-width: 60px; preferred-width: 100px; max-width: 100px; horizontal-stretch: 0; model: SwitchesUi.key-names; current-index: p.a; enabled: !SwitchesUi.busy; selected => { SwitchesUi.set-pair(i, self.current-index, p.b, p.mode, p.both); } }
                    Text { text: "and"; color: Theme.text-dim; font-size: Theme.small; vertical-alignment: center; horizontal-stretch: 0; }
                    ComboBox { min-width: 60px; preferred-width: 100px; max-width: 100px; horizontal-stretch: 0; model: SwitchesUi.key-names; current-index: p.b; enabled: !SwitchesUi.busy; selected => { SwitchesUi.set-pair(i, p.a, self.current-index, p.mode, p.both); } }
                    ComboBox { min-width: 120px; preferred-width: 170px; max-width: 170px; horizontal-stretch: 0; model: SwitchesUi.tap-modes; current-index: p.mode; enabled: !SwitchesUi.busy; selected => { SwitchesUi.set-pair(i, p.a, p.b, self.current-index, p.both); } }
                    // Kept on one line: wrapped, a row would come out shorter than it is.
                    Toggle { min-width: 92px; horizontal-stretch: 0; text: "send both"; checked: p.both; enabled: !SwitchesUi.busy; toggled(v) => { SwitchesUi.set-pair(i, p.a, p.b, p.mode, v); } }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Button { text: "Remove"; small: true; enabled: !SwitchesUi.busy; clicked => { SwitchesUi.remove-pair(i); } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Button { text: "Add a pair"; enabled: !SwitchesUi.busy && SwitchesUi.pairs.length < 10; clicked => { SwitchesUi.add-pair(); } }
                    Unit { text: "\{SwitchesUi.pairs.length} of 10"; }
                }
                Hint { text: "What each mode does comes from other projects' notes; it hasn't been checked on this keyboard yet."; }
            } }
        } }
        Opt { shown: SwitchesUi.refused != ""; ErrorLine { text: "The keyboard refused the switch settings: " + SwitchesUi.refused; } }
        Opt { shown: SwitchesUi.error != ""; ErrorLine { text: SwitchesUi.error; } }
    }
}

component Screen {
    VerticalLayout {
        Head { text: "SCREEN"; }
        Opt { HorizontalLayout {
            alignment: start;
            Segmented { options: ["Keyboard's own", "Text", "Clock", "Picture"]; current: ScreenUi.kind; enabled: !ScreenUi.busy; picked(i) => { ScreenUi.pick(i); } }
        } }
        Opt { shown: ScreenUi.kind == 1; gap: 12px; VerticalLayout {
            spacing: 10px;
            HorizontalLayout {
                alignment: start;
                TextEdit {
                    width: 220px;
                    height: 128px;
                    font-size: 14px;
                    font-family: Theme.mono;
                    text <=> ScreenUi.text;
                    enabled: !ScreenUi.busy;
                    edited(t) => { ScreenUi.text-edited(t); }
                }
            }
            Text {
                text: "Up to 5 lines of 16 characters, plain ASCII. Short text is drawn bigger.";
                color: ScreenUi.too-long ? Theme.danger : Theme.text-dim;
                font-size: Theme.small;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: start;
                Button { text: "Show on the keyboard"; enabled: !ScreenUi.busy && !ScreenUi.too-long && !ScreenUi.blank; clicked => { ScreenUi.show-text(); } }
            }
        } }
        Opt { shown: ScreenUi.kind == 2; gap: 12px; HorizontalLayout {
            spacing: 18px;
            alignment: start;
            Toggle { text: "24-hour"; checked: ScreenUi.h24; enabled: !ScreenUi.busy; toggled(v) => { ScreenUi.set-clock(v, ScreenUi.seconds, ScreenUi.date); } }
            Toggle { text: "Seconds"; checked: ScreenUi.seconds; enabled: !ScreenUi.busy; toggled(v) => { ScreenUi.set-clock(ScreenUi.h24, v, ScreenUi.date); } }
            Toggle { text: "Date"; checked: ScreenUi.date; enabled: !ScreenUi.busy; toggled(v) => { ScreenUi.set-clock(ScreenUi.h24, ScreenUi.seconds, v); } }
        } }
        Opt { shown: ScreenUi.kind == 3; gap: 12px; VerticalLayout {
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button { text: "Choose a picture…"; enabled: !ScreenUi.busy; clicked => { ScreenUi.choose-picture(); } }
                Text { text: ScreenUi.file-name; color: Theme.text-dim; font-size: Theme.small; vertical-alignment: center; overflow: elide; }
            }
            Opt { shown: ScreenUi.has-preview; HorizontalLayout {
                alignment: start;
                Rectangle {
                    width: 386px;
                    height: 122px;
                    background: #0a0a0a;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.line;
                    clip: true;
                    Image { width: 384px; height: 120px; source: ScreenUi.preview; image-rendering: pixelated; }
                }
            } }
            Opt { shown: ScreenUi.has-source; VerticalLayout {
                spacing: 10px;
                Row {
                    label: "Threshold";
                    thr := AccentSlider { minimum: 1; maximum: 254; value: ScreenUi.threshold; changed(v) => { ScreenUi.set-threshold(v); } released(v) => { ScreenUi.set-threshold(v); } }
                    Unit { text: thr.shown; }
                }
                HorizontalLayout {
                    spacing: 18px;
                    alignment: start;
                    Toggle { text: "Dither"; checked: ScreenUi.dither; toggled(v) => { ScreenUi.set-dither(v); } }
                    Toggle { text: "Invert"; checked: ScreenUi.invert; toggled(v) => { ScreenUi.set-invert(v); } }
                }
                HorizontalLayout {
                    alignment: start;
                    Button { text: "Show on the keyboard"; enabled: !ScreenUi.busy; clicked => { ScreenUi.show-picture(); } }
                }
            } }
        } }
        Opt { shown: ScreenUi.care; gap: 18px; VerticalLayout {
            SubTitle { text: "Burn-in care"; }
            Opt { gap: 8px; Toggle { text: "Move the picture a pixel every couple of minutes"; checked: ScreenUi.shift; enabled: !ScreenUi.busy; toggled(v) => { ScreenUi.set-care(v, ScreenUi.away, ScreenUi.own-too); } } }
            Opt { gap: 8px; Toggle { text: "Dark while nobody's at the computer (locked, asleep, or logged out)"; checked: ScreenUi.away; enabled: !ScreenUi.busy; toggled(v) => { ScreenUi.set-care(ScreenUi.shift, v, ScreenUi.own-too); } } }
            Opt { gap: 8px; HorizontalLayout {
                padding-left: 24px;
                Toggle { text: "The keyboard's own screen too"; checked: ScreenUi.own-too; enabled: !ScreenUi.busy && ScreenUi.away; toggled(v) => { ScreenUi.set-care(ScreenUi.shift, ScreenUi.away, v); } }
            } }
            Opt { shown: ScreenUi.resting; gap: 8px; Hint { text: "Resting now: nobody's at the computer."; } }
        } }
        Opt { shown: ScreenUi.refused != ""; ErrorLine { text: "The keyboard refused the picture: " + ScreenUi.refused; } }
        Opt { shown: ScreenUi.error != ""; ErrorLine { text: ScreenUi.error; } }
    }
}

export component KeyboardPanel inherits Card {
    PanelHead {
        icon: @image-url("icons/keyboard.svg");
        title: "Apex Pro TKL Gen 3";
        meta: KeyboardUi.connected ? "connected" : "not connected";
    }
    Shown { shown: KeyboardUi.known; gap: 0; VerticalLayout {
        padding-top: 4px;
        spacing: 16px;
        Divider { }
        Lighting { }
        Divider { }
        Switches { }
        Divider { }
        Screen { }
    } }
}
