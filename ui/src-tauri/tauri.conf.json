{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gglinux",
  "version": "0.0.1",
  "identifier": "io.github.ykk.gglinux",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "gglinux",
        "width": 1120,
        "height": 740,
        "minWidth": 900,
        "minHeight": 580,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "Open-source SteelSeries GG for Linux",
    "longDescription": "Control SteelSeries keyboards, mice and headsets on Linux: lighting, DPI, actuation, equaliser, ChatMix and per-app audio routing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
